# --- Saat build (Coolify: Build Variables) ---
# URL publik Supabase AAwQData dan kunci publik (anon/publishable). Aman berada di browser.
VITE_SUPABASE_URL=https://supabase-aawq.contoh.id
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Saat berjalan (Coolify: Environment Variables) ---
SUPABASE_URL=https://supabase-aawq.contoh.id
# Kunci service role: RAHASIA, hanya di server. Jangan pernah diberi awalan VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Gateway AABaileys khusus perangkat pengecek (instance terpisah dari WSPRO).
WA_GATEWAY_URL=https://wa-cek.contoh.id
WA_GATEWAY_API_KEY=
# Gateway AABaileys milik WSPRO (sumber reader "AABaileys WSPRO" di menu Pengaturan): url|kunci, dipisah koma.
# Perangkat yang tersambung di WSPRO bisa dipakai sebagai reader. Kosongkan bila tidak dipakai.
WSPRO_GATEWAYS=https://wg1.contoh.id|kunci-gateway-1,https://wg2.contoh.id|kunci-gateway-2
PORT=3000
